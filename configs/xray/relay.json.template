{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xeno/ru-access.log",
    "error": "/var/log/xeno/ru-error.log"
  },
  "inbounds": [
    {
      "tag": "client-in",
      "listen": "0.0.0.0",
      "port": {{CLIENT_PORT}},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{CLIENT_UUID}}",
            "email": "happ-client"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "path": "{{BRIDGE_PATH}}",
          "mode": "stream-one"
        },
        "realitySettings": {
          "show": false,
          "dest": "{{BRIDGE_REALITY_DEST}}",
          "xver": 0,
          "serverNames": ["{{BRIDGE_REALITY_SNI}}"],
          "privateKey": "{{BRIDGE_REALITY_PRIVATE_KEY}}",
          "shortIds": ["{{BRIDGE_REALITY_SHORT_ID}}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "nl-exit",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{NL_EXIT_IP}}",
            "port": {{RELAY_PORT}},
            "users": [
              {
                "id": "{{RELAY_UUID}}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "path": "{{RELAY_PATH}}",
          "mode": "stream-one"
        },
        "realitySettings": {
          "serverName": "{{RELAY_REALITY_SNI}}",
          "fingerprint": "chrome",
          "publicKey": "{{RELAY_REALITY_PUBLIC_KEY}}",
          "shortId": "{{RELAY_REALITY_SHORT_ID}}"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:category-ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "domain:ozon.ru",
          "domain:ozon.com",
          "domain:o3.ru",
          "domain:ozone.ru",
          "domain:ozonusercontent.com",
          "domain:ozonru.me",
          "domain:magnit.ru",
          "domain:magnit.com",
          "domain:magnit-info.ru",
          "domain:magnit.online"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "nl-exit"
      }
    ]
  }
}
