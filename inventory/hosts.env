# Публичный шаблон inventory. Скопируйте в hosts.local.env и заполните реальные значения.
# hosts.local.env в .gitignore — не коммитить.
#
# Документационные IP (RFC 5737) — только примеры, не прод.

NL_EXIT_IP=203.0.113.10
RU_BRIDGE_IP=203.0.113.20
YC_WHITELIST_IP=
SSH_USER=root
DOMAIN=example.com
RU_DOMAIN=entry.example.com
NL_DOMAIN=exit.example.com
# Public Happ subscription base (HTTPS, required). Example after enable_sub_https.py:
# SUB_PUBLIC_BASE=https://exit.example.com:2080
REALITY_SNI=www.example.com
REALITY_DEST=www.example.com:443
RELAY_PORT=8443
NL_DIRECT_PORT=2053
HY2_PORT=8444
CLIENT_PORT=443
TIMEZONE=UTC
NL_MODE=coexist
RU_MODE=clean
YC_MODE=deferred
TOPOLOGY=two-node
