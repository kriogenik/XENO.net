# Секреты и сгенерированные ключи — НЕ коммитить
secrets/*
!secrets/README.md
# dry-run may create nested files; keep ignored under secrets/

# Локальные override (прод-IP и хосты)
inventory/hosts.local.yml
inventory/hosts.local.env
*.local.yml
*.local.env

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.cursor/

# Python
__pycache__/
*.pyc
.venv/
scripts/lib/__pycache__/

